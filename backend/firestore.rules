rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Usuarios - privado
    match /users/{userId} {
      allow read: if request.auth.uid == userId;
      allow create: if request.auth.uid != null;
      allow update: if request.auth.uid == userId || request.auth.token.admin == true;
      allow delete: if request.auth.token.admin == true;
    }

    // Productos - públicos para leer
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if request.auth.token.admin == true;
    }

    // Categorías - públicas para leer
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if request.auth.token.admin == true;
    }

    // Ventas
    match /sales/{saleId} {
      allow read: if request.auth.uid != null;
      allow create: if request.auth.uid != null;
      allow update, delete: if request.auth.token.admin == true || request.auth.uid == resource.data.vendedorId;
    }

    // Settings
    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }

  }
}
